# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Anchored to the repo root so these Python build-artifact rules never collide
# with app/frontend/dist/ (the committed SPA build -- see Node section below).
/dist/
/build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
# NOTE: app/frontend/dist/ is intentionally COMMITTED and NOT ignored. The
# Databricks Apps runtime has no build step (app.yaml runs pip + uvicorn only)
# and `bundle deploy` skips gitignored paths, so the built SPA must be tracked
# for a plain deploy to ship a working frontend. The Python dist/ rule above is
# anchored to the repo root (/dist/), so it never matches this path -- the whole
# folder is tracked like any normal directory. Rebuild with `make build`.

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Databricks
.databricks/

# Session memory
MEMORY.md

# v0 reference (extracted zip)
.v0-reference/

# Design artifacts (raw exports)
*.zip
