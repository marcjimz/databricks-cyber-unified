# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
# NOTE: app/frontend/dist/ is intentionally COMMITTED. The Databricks Apps
# runtime has no build step (app.yaml runs pip + uvicorn only) and bundle
# deploy skips gitignored paths, so the built SPA must be tracked for a
# plain `bundle deploy` to ship a working frontend. Rebuild with `make build`.
# Negate the broad Python `dist/` rule above for this one path.
!app/frontend/dist/
!app/frontend/dist/**

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Databricks
.databricks/

# Session memory
MEMORY.md

# v0 reference (extracted zip)
.v0-reference/

# Design artifacts (raw exports)
*.zip
