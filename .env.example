# ── Databricks workspace connection (local dev) ──
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# ── Provider selection ──
# "seed"       = in-memory OCSF synthesis, zero workspace deps (default for local dev)
# "metricview" = query the ALREADY-PUBLISHED UC metric view on the SQL Warehouse
#                (per-user OBO). This is the deployed path.
CYBERUNIFIED_PROVIDER=seed

# ── SQL Warehouse ──
# Serves the metric-view KPI + drill-down reads AND the Genie interactive drawer.
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# ── Unity Catalog ──
# Where the app LOOKS for the published metric view named by
# domains[].metric_view.name in app/cyber-unified.yaml. The app reads that view;
# it never creates it.
CYBERUNIFIED_CATALOG=cyber-unified
CYBERUNIFIED_SCHEMA=posture

# ── Lakebase (managed Postgres, autoscaling) ── APP STATE ONLY
# Holds preferences / chats / sessions. KPI reads do NOT go through Lakebase.
# Fully-qualified endpoint path: projects/<project>/branches/<branch>/endpoints/<endpoint>
LAKEBASE_ENDPOINT_NAME=projects/cyber-unified/branches/production/endpoints/primary
LAKEBASE_DATABASE_NAME=cyber-unified
# Local dev only: set PGHOST to skip the get_endpoint lookup, PGUSER for the role.
# PGHOST=
# PGUSER=

# ── Genie Space embed URLs (optional; interactive drawer) ──
GENIE_PHISHING_EMBED_URL=
