# CyberUnified local configuration, read by `make local`, the lakebase CLI, and the
# Lakebase SCM VS Code extension. Copy to .env (the extension's post-checkout hook
# does this for you). Never committed; CI and the deployed app don't use it.
#
# Local auth is your own Databricks login: run `databricks auth login` once. No PAT,
# client ID, client secret, or database password is stored here.

# --- You set these ------------------------------------------------------------
# The Lakebase project paired with this repo -- databricks_dev's app-state project
# (databricks.yml: lakebase_project). Feature branches fork off its `production`.
LAKEBASE_PROJECT_ID=cyber-unified-dev
DATABRICKS_HOST=https://fevm-real-time-mode-demo.cloud.databricks.com
# Your `databricks auth login` profile for this workspace -- the same one the
# databricks_dev target names in databricks.yml. Find it with:
#   databricks auth profiles
# and pick a profile for this workspace's host whose Valid column is YES (check: databricks current-user me -p <profile>).
# Required when several profiles point at the same workspace; with only DATABRICKS_HOST the
# CLI can't choose and the extension reports "session does not read back as authenticated".
DATABRICKS_CONFIG_PROFILE=fe-vm-real-time-mode-demo

# --- App settings (make local) --------------------------------------------------
# "seed"       = in-memory synthesis from pipelines/lib/generator.py, zero workspace deps
# "metricview" = query the ALREADY-PUBLISHED UC metric view on the SQL Warehouse
#                (per-user OBO). This is the deployed path.
CYBERUNIFIED_PROVIDER=seed
# Serves the metric-view KPI + drill-down reads AND the Genie interactive drawer.
DATABRICKS_WAREHOUSE_ID=1916c91c970b63b5
# Where the app LOOKS for the published metric view named by
# domains[].metric_view.name in app/cyber-unified.yaml. The app reads it; it never
# creates it.
CYBERUNIFIED_CATALOG=real_time_mode_demo_catalog
CYBERUNIFIED_SCHEMA=posture
# The app-state database inside the Lakebase project (databricks.yml:
# lakebase_database). Wins over the Lakebase default db in DATABASE_URL below.
DB_NAME=cyber-unified-dev
# Genie Space embed URL (optional; interactive drawer).
GENIE_PHISHING_EMBED_URL=

# --- Branch connection: written by the Lakebase SCM extension (do not edit) ----
# Filled in on every git branch switch or Refresh Credentials. Optional: until then
# the app looks the host up from LAKEBASE_ENDPOINT_NAME (main -> production). The
# app reads LAKEBASE_HOST and DB_USERNAME directly; no password is needed here
# (the app mints a short-lived OAuth credential).
# LAKEBASE_BRANCH_ID=
# LAKEBASE_HOST=
# LAKEBASE_ENDPOINT=primary
# DB_USERNAME=
# DATABASE_URL=            # optional fixed override (postgresql://...)

# --- Optional -----------------------------------------------------------------
# LAKEBASE_MAIN_BRANCH_ID=production
# LAKEBASE_ENDPOINT_NAME=projects/cyber-unified-dev/branches/production/endpoints/primary
# DATABRICKS_TOKEN=        # only for CYBERUNIFIED_PROVIDER=metricview locally (stands in for the OBO token)

# --- CI/CD only: never put these in .env --------------------------------------
# The GitHub workflows authenticate as a service principal (OAuth M2M). Its
# secrets live in the GitHub environments dev | tst | prd; see README → CI/CD.
#   DATABRICKS_HOST / DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET
# .github/actions/databricks-auth writes them under the profile name each
# databricks.yml target declares, so CI and local auth share that one name.
