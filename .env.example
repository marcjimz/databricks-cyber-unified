# ── Databricks workspace connection (local dev) ──
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# ── Provider selection ──
# "seed"     = in-memory OCSF synthesis, zero workspace deps (default for local dev)
# "lakebase" = read synced KPI aggregates from Lakebase Postgres via OBO
CYBER360_PROVIDER=seed

# ── SQL Warehouse (Genie interactive drawer ONLY, never KPI reads) ──
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# ── Unity Catalog ──
CYBER360_CATALOG=cyber360
CYBER360_SCHEMA=posture

# ── Lakebase (managed Postgres) ──
LAKEBASE_INSTANCE_NAME=cyber360-lakebase
LAKEBASE_DATABASE_NAME=cyber360

# ── Genie Space embed URLs (optional; interactive drawer) ──
GENIE_IDENTITY_EMBED_URL=
GENIE_VULNERABILITY_EMBED_URL=
